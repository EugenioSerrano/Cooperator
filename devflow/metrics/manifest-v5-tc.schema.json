{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avenga:devflow:manifest:tc:v5",
  "title": "Avenga DevFlow Test Case Manifest v5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tc",
    "verifies",
    "test_bolts",
    "checkpoint_approvals"
  ],
  "properties": {
    "schema_version": {
      "const": "5.0"
    },
    "tc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ref",
        "sources",
        "generation",
        "review_ready_at",
        "review_started_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^TC-[0-9]{3}$"
        },
        "ref": {
          "$ref": "#/$defs/repositoryRef"
        },
        "sources": {
          "$ref": "#/$defs/sources"
        },
        "generation": {
          "$ref": "#/$defs/generation"
        },
        "review_ready_at": {
          "$ref": "#/$defs/dateTimeOrNull"
        },
        "review_started_at": {
          "$ref": "#/$defs/dateTimeOrNull"
        }
      }
    },
    "verifies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_bolt",
        "source_us",
        "covered_acs"
      ],
      "properties": {
        "source_bolt": {
          "type": "string",
          "pattern": "^US-[0-9]{3}\\.BOLT-[0-9]{3,4}$"
        },
        "source_us": {
          "type": "string",
          "pattern": "^US-[0-9]{3}$"
        },
        "covered_acs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "test_bolts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/repositoryRef"
      },
      "uniqueItems": true
    },
    "checkpoint_approvals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/checkpointApproval"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verifies": {
            "properties": {
              "source_us": {
                "not": {
                  "const": "US-000"
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "verifies": {
            "properties": {
              "covered_acs": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "repositoryRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/repositoryRef"
      },
      "uniqueItems": true
    },
    "dateTimeOrNull": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_uncached",
        "input_cached_read",
        "input_cache_write",
        "output"
      ],
      "properties": {
        "input_uncached": {
          "$ref": "#/$defs/nonNegativeIntegerOrNull"
        },
        "input_cached_read": {
          "$ref": "#/$defs/nonNegativeIntegerOrNull"
        },
        "input_cache_write": {
          "$ref": "#/$defs/nonNegativeIntegerOrNull"
        },
        "output": {
          "$ref": "#/$defs/nonNegativeIntegerOrNull"
        }
      }
    },
    "nonNegativeIntegerOrNull": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "provider",
        "model",
        "tokens",
        "agent"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "tokens": {
          "$ref": "#/$defs/tokens"
        },
        "agent": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_at",
        "created_by",
        "runs",
        "duration_seconds"
      ],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_by": {
          "type": "string",
          "pattern": "^(human|agent):.+"
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/run"
          }
        },
        "duration_seconds": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "approver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "role",
        "model"
      ],
      "properties": {
        "actor": {
          "type": "string",
          "pattern": "^(human|agent):.+"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "actor": {
                "pattern": "^agent:"
              }
            }
          },
          "then": {
            "properties": {
              "model": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "model": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "checkpointApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint",
        "subject",
        "decision",
        "decided_by",
        "decided_at"
      ],
      "properties": {
        "checkpoint": {
          "enum": ["AITL-TC-Approval"]
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref"
          ],
          "properties": {
            "ref": {
              "$ref": "#/$defs/repositoryRef"
            }
          }
        },
        "decision": {
          "enum": [
            "approved",
            "changes_requested",
            "rejected"
          ]
        },
        "decided_by": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/approver"
          }
        },
        "written_by": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/approver"
          }
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        },
        "comment": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
