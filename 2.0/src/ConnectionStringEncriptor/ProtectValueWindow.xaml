<Window x:Class="ConnectionStringEncriptor.ProtectValueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Protección de valores — Cooperator" Height="330" Width="640"
        WindowStartupLocation="CenterScreen">
    <!--
      SPEC-261016-0043 §6/A.2, §6/B.1 y AC-4: UI MÍNIMA del paso único.
        · El operador aporta SÓLO el valor (enmascarado) y la clave de configuración de destino (el AAD).
        · NO hay selector de algoritmo, de esquema ni de clave: la clave activa la aporta el motor.
        · El valor en claro no se muestra, no se persiste y no se registra; al cerrar el paso, se limpia.
    -->
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center"
                   Text="Clave de configuración de destino (AAD)" />
        <TextBox x:Name="DestinationKeyBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                 Text="Cooperator:ConnectionStrings:CooperatorConnectionString" />

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Valor a proteger" />
        <PasswordBox x:Name="ValueBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />

        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="ProtectButton" Content="Proteger" Width="120" Height="28" Click="OnProtectClick" />
            <TextBlock x:Name="KidText" Margin="16,0,0,0" VerticalAlignment="Center" Text="" />
        </StackPanel>

        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center"
                   Text="Valor protegido (copiable)" />
        <TextBox x:Name="ProtectedValueBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" IsReadOnly="True"
                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MinHeight="60" />

        <TextBlock x:Name="DiagnosticsText" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0"
                   TextWrapping="Wrap" Foreground="#B00020" VerticalAlignment="Top" />

        <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,8" TextWrapping="Wrap"
                   Foreground="#555"
                   Text="El valor protegido se resuelve con el resolutor del framework en la clave de destino indicada. El valor en claro no se guarda en ningún lado." />
    </Grid>
</Window>
